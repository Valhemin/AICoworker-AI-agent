// Schema AICoworker: agents.list (không phải agents.entries).
// Trước khi merge: thay mọi <REPO_ROOT> bằng đường dẫn tuyệt đối tới clone repo này.
// Agent mặc định của app là id "main" (không xóa được) — dùng workspace ceo, name CEO.
// Model để trống → dùng model mặc định trong openclaw.json; hoặc trỏ 9router agent-*.
// skills = allowlist. extraDirs = thư mục cha một cấp (<dir>/<skill>/SKILL.md).
// Không ghi API key / bot token vào file này hay vào git.

{
  // Telegram: bật trên máy thật (enabled: true + tokenFile có token). Không commit token.
  // Agent ghi DONE-/RISK-/BLOCKED- vào shared/05_Approvals/Pending/; CEO heartbeat gửi tóm tắt.
  channels: {
    telegram: {
      enabled: false,
      dmPolicy: "pairing",
      tokenFile: "<HOME>/.openclaw/credentials/telegram.bot.token",
      groupPolicy: "allowlist"
    }
  },
  mcp: {
    servers: {
      rea: {
        command: "npx",
        args: [
          "-y",
          "rea-agents@6.5.0",
          "--mcp"
        ],
        enabled: true
      }
    }
  },
  skills: {
    load: {
      extraDirs: [
        "<REPO_ROOT>/library/skills/_catalog",
        "<REPO_ROOT>/library/skills/_shared",
        "<REPO_ROOT>/library/skills/analyst",
        "<REPO_ROOT>/library/skills/application",
        "<REPO_ROOT>/library/skills/architect",
        "<REPO_ROOT>/library/skills/browser",
        "<REPO_ROOT>/library/skills/ceo",
        "<REPO_ROOT>/library/skills/creator",
        "<REPO_ROOT>/library/skills/creator-publish",
        "<REPO_ROOT>/library/skills/creator-research",
        "<REPO_ROOT>/library/skills/creator-story",
        "<REPO_ROOT>/library/skills/creator-visual",
        "<REPO_ROOT>/library/skills/debug",
        "<REPO_ROOT>/library/skills/designer",
        "<REPO_ROOT>/library/skills/developer-personal",
        "<REPO_ROOT>/library/skills/developer-work",
        "<REPO_ROOT>/library/skills/implement",
        "<REPO_ROOT>/library/skills/marketer",
        "<REPO_ROOT>/library/skills/office",
        "<REPO_ROOT>/library/skills/rea",
        "<REPO_ROOT>/library/skills/reviewer",
        "<REPO_ROOT>/library/skills/sales",
        "<REPO_ROOT>/library/skills/support",
        "<REPO_ROOT>/library/skills/tester"
      ],
      watch: true
    }
  },
  agents: {
    // Compaction: reserve tuyệt đối. Flush ≈ contextWindow − 20000 − 4000.
    // contextWindow agent-*: 200k mặc định, 256k cho browser/research/designer — không 1M (đã có memoryFlush).
    defaults: {
      compaction: {
        mode: "safeguard",
        reserveTokensFloor: 20000,
        memoryFlush: {
          enabled: true,
          softThresholdTokens: 4000,
          forceFlushTranscriptBytes: 33554432 // 32MB
        }
      }
    },
    list: [
      {
        id: "main",
        name: "CEO",
        default: true,
        workspace: "<REPO_ROOT>/workspaces/ceo",
        skills: [
          "route-work",
          "work-plan",
          "market-choice",
          "release-to-users",
          "release-readiness",
          "founder-next-moves",
          "founder-sop"
        ],
        subagents: {
          allowAgents: [
            "analyst",
            "architect",
            "designer",
            "implement",
            "reviewer",
            "tester",
            "debug",
            "rea",
            "marketer",
            "sales",
            "support",
            "browser",
            "office",
            "application",
            "creator",
            "creator-research",
            "creator-story",
            "creator-visual",
            "creator-publish",
            "developer-work",
            "developer-personal"
          ]
        }
      },
      {
        id: "analyst",
        name: "analyst",
        workspace: "<REPO_ROOT>/workspaces/analyst",
        skills: [
          "idea-evaluate",
          "idea-fit"
        ],
        subagents: {
          allowAgents: [
            "browser",
            "creator-research"
          ]
        }
      },
      {
        id: "marketer",
        name: "marketer",
        workspace: "<REPO_ROOT>/workspaces/marketer",
        skills: [
          "brand-profile",
          "audience-channel",
          "launch-sprint",
          "content-calendar",
          "competitor-watch"
        ],
        subagents: {
          allowAgents: [
            "browser",
            "creator",
            "creator-research",
            "designer"
          ]
        }
      },
      {
        id: "support",
        name: "support",
        workspace: "<REPO_ROOT>/workspaces/support",
        skills: [
          "customer-issue",
          "user-faq"
        ],
        subagents: {
          allowAgents: [
            "architect",
            "creator"
          ]
        }
      },
      {
        id: "rea",
        name: "rea",
        workspace: "<REPO_ROOT>/workspaces/rea",
        skills: [
          "rea-investigate"
        ],
        subagents: {
          allowAgents: []
        }
      },
      {
        id: "developer-work",
        name: "developer-work",
        workspace: "<REPO_ROOT>/workspaces/developer-work",
        skills: [
          "company-task"
        ],
        subagents: {
          allowAgents: [
            "architect",
            "implement",
            "reviewer",
            "debug",
            "tester",
            "rea"
          ]
        }
      },
      {
        id: "developer-personal",
        name: "developer-personal",
        workspace: "<REPO_ROOT>/workspaces/developer-personal",
        skills: [
          "personal-task",
          "search-first",
          "feature-implementation",
          "tasks-md-execution",
          "tdd-red-green-refactor",
          "research-before-implement",
          "root-cause-debugging",
          "regression-test-design",
          "build-fix-loop",
          "verify-change",
          "work-plan",
          "security-threat-model",
          "mcp-server-build",
          "mcp-connect",
          "follow-design",
          "web-seo",
          "command-risk",
          "code-structure"
        ],
        subagents: {
          allowAgents: [
            "architect",
            "implement",
            "reviewer",
            "debug",
            "tester",
            "rea"
          ]
        }
      },
      {
        id: "architect",
        name: "architect",
        workspace: "<REPO_ROOT>/workspaces/architect",
        skills: [
          "new-project-discovery",
          "product-requirements",
          "technical-architecture",
          "writing-plans-superpowers",
          "lead-decomposition",
          "spec-consistency-analysis",
          "stack-selection",
          "work-plan"
        ],
        subagents: {
          allowAgents: [
            "designer",
            "implement",
            "debug",
            "tester"
          ]
        }
      },
      {
        id: "designer",
        name: "designer",
        workspace: "<REPO_ROOT>/workspaces/designer",
        skills: [
          "design-direction",
          "ui-ux-spec",
          "product-brand",
          "design-check"
        ],
        subagents: {
          allowAgents: []
        }
      },
      {
        id: "implement",
        name: "implement",
        workspace: "<REPO_ROOT>/workspaces/implement",
        skills: [
          "feature-implementation",
          "tasks-md-execution",
          "search-first",
          "research-before-implement",
          "test-strategy",
          "build-fix-loop",
          "incremental-self-review",
          "verify-change",
          "follow-design",
          "web-seo",
          "mcp-server-build",
          "mcp-connect",
          "work-plan",
          "security-threat-model",
          "command-risk",
          "code-structure",
          // platform skills — load the one matching the current project stack
          "frontend-react",
          "backend-api",
          "nextjs-patterns",
          "electron-desktop",
          "tdd-red-green-refactor",
          // dead-reference fixes now resolved
          "api-integration-workflow",
          "error-handling-patterns",
          "api-testing",
          "db-migration-workflow",
          "env-config-management",
          "observability-setup"
        ],
        subagents: {
          allowAgents: [
            "reviewer",
            "debug",
            "tester",
            "browser"
          ]
        }
      },
      {
        id: "reviewer",
        name: "reviewer",
        workspace: "<REPO_ROOT>/workspaces/reviewer",
        skills: [
          "independent-review",
          "command-risk"
        ],
        subagents: {
          allowAgents: [
            "implement",
            "tester"
          ]
        }
      },
      {
        id: "sales",
        name: "sales",
        workspace: "<REPO_ROOT>/workspaces/sales",
        skills: [
          "sales-context",
          "value-prop",
          "discovery-prep",
          "objection-handling",
          "deal-brief",
          "deal-close",
          "win-loss"
        ],
        subagents: {
          allowAgents: [
            "browser",
            "marketer"
          ]
        }
      },
      {
        id: "tester",
        name: "tester",
        workspace: "<REPO_ROOT>/workspaces/tester",
        skills: [
          "product-test",
          "qa-plan",
